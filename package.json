{
  "name": "Saude360",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/ && eslint . --fix",
    "lint:ci": "eslint .",
    "build:dev": "vite build --mode development",
    "build:hml": "vite build --mode hml",
    "build:prod": "vite build --mode prod",
    "preview:dev": "npm run build:dev && npm run preview",
    "preview:hml": "npm run build:hml && npm run preview",
    "preview:prod": "npm run build:prod && npm run preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "leaflet": "^1.9.4",
    "primevue": "^4.5.5",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "npm-run-all2": "^7.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.1.10"
  },
  "description": "Guia de unidades de saúde com Vue 3, mapas e APIs públicas"
}
